# URL base de produção da API ApiSTI (fornecida pela plataforma de telemarketing)
API_BASE_URL=https://tele.ongrentavel.com.br/scriptcase/app/ApiSTI/blank/

# Token padrão (usado quando o cliente não tem token individual em config/clients.json)
API_TOKEN=

# Limite de registros por página (default usado nos scripts se não passado via --limite)
API_DEFAULT_LIMITE=1000
